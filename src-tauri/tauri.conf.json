{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "繪匣 PaintDeck",
  "version": "26.1031.4",
  "identifier": "local.anima.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "本機 AI 生圖（ComfyUI 前端）",
    "resources": {
      "../ui/": "ui/",
      "../resources/": "resources/",
      "../vendor/onnxruntime/onnxruntime.dll": "onnxruntime.dll",
      "../vendor/7zip/7zr.exe": "7zr.exe",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MzZGNzlDMjhDQTUwODIKUldTQ1VNb29uUGMyNUJmRzl0TFNoa0IyeVYxQjFNZmkrNGgzZDVLM25INjhiZ1BnL3pPeU1ydkwK",
      "endpoints": [
        "https://github.com/sressky12-ux/PaintDeck/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
