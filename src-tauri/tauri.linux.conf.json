{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaintDeck",
  "bundle": {
    "createUpdaterArtifacts": false,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "resources": {
      "../vendor/onnxruntime/onnxruntime.dll": null,
      "../vendor/7zip/7zr.exe": null,
      "../vendor/onnxruntime/libonnxruntime.so": "libonnxruntime.so"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/paintdeck.desktop"
      }
    }
  }
}
